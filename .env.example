# Supabase — lấy từ Dashboard > Project Settings > API keys (New API keys)
# Publishable key (an toàn để lộ ra browser). KHÔNG dùng secret/service_role key ở client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable
SUPABASE_SECRET_KEY=sb_secret
SMAX_TOKEN=SMAX
FB_TOKEN=FB_TOKEN1
# Claude API (AI tóm tắt) — lấy key tại https://platform.claude.com/settings/keys
# CHỈ dùng phía server (Server Action / Route Handler). KHÔNG thêm tiền tố NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-api03-...
