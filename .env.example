NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable
SUPABASE_SECRET_KEY=sb_secret
SMAX_TOKEN=SMAX
FB_TOKEN=FB_TOKEN1
